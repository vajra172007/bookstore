PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/bookstore
# Any long random text. Used to sign login tokens (required).
JWT_SECRET=change-this-to-a-long-random-string

# Order confirmation email (Gmail SMTP). Use a Google App Password (needs 2-Step Verification), NOT your normal password.
# Leave both blank for preview mode: emails are saved to email-previews/ and NOT sent.
EMAIL_USER=
EMAIL_APP_PASSWORD=
